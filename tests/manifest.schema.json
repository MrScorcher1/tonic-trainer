{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tonic Trainer puzzle manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "audio_path",
      "tonic_pc",
      "mode",
      "key_display",
      "title",
      "artist",
      "license",
      "license_canonical",
      "genre_top",
      "difficulty"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^fma-[0-9]{6}$" },
      "audio_path": { "type": "string", "pattern": "^[0-9]{3}/[0-9]{6}\\.mp3$" },
      "tonic_pc": { "type": "integer", "minimum": 0, "maximum": 11 },
      "mode": { "type": "string", "enum": ["major", "minor"] },
      "key_display": { "type": "string", "pattern": "^[A-G][#b]? (Major|minor)$" },
      "title": { "type": "string", "minLength": 1 },
      "artist": { "type": "string", "minLength": 1 },
      "license": { "type": "string", "minLength": 1 },
      "license_canonical": { "type": "string", "minLength": 1 },
      "genre_top": { "type": ["string", "null"] },
      "difficulty": { "type": "string", "enum": ["tier1", "tier2", "tier3", "untagged"] }
    }
  }
}
